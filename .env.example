# ==============================================================================
# VERBORA Environment Variables
# Copy this file to .env.local and fill in your Supabase project values
# ==============================================================================

# Supabase Project URL (found in Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (found in Project Settings -> API -> Project API Keys -> anon / public)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
